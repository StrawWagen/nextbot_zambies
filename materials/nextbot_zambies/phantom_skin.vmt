"VertexLitGeneric"
{
	"$basetexture"	"nextbot_zambies/phantom_skin"
	"$model" "1"
       "$translucent" = 1
       "$vertexalpha" = 1
       "$vertexcolor" = 1
    "Proxies"
    {
        "TextureScroll"
        {
            "texturescrollvar" "$basetexturetransform"
            "texturescrollrate" 0.50
            "texturescrollangle" -45
        }
    }
}
